# 仅查看检索结果时可以留空
OPENAI_API_KEY=
# 使用 OpenAI 官方接口时可以留空
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# 默认禁止传输检索片段；确认模型服务的数据处理边界后才设为 true
RAG_ALLOW_LLM_CONTEXT_TRANSFER=false

# data/ 中有 PDF 时填写 MinerU 官方 API Token
MINERU_API_KEY=
# 默认禁止向 MinerU 上传原始文件；确认文档允许外发后才设为 true
RAG_ALLOW_MINERU_UPLOAD=false

# 默认使用仓库 models/ 下的目录；路径不同时取消注释并修改
# LOCAL_EMBED_MODEL_PATH=D:/path/to/bge-base-zh-v1.5
# LOCAL_RERANK_MODEL_PATH=D:/path/to/bge-reranker-base
# CHROMA_DIR=D:/path/to/chroma_db
